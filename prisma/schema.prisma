generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String    @id @default(uuid())
  username     String    @unique
  email        String    @unique
  passwordHash String
  role         String    @default("ADMIN")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLogin    DateTime?
}

model Episode {
  id              String   @id @default(uuid())
  youtubeVideoId  String   @unique
  title           String
  slug            String   @unique
  description     String
  thumbnailUrl    String
  videoUrl        String
  duration        String?
  viewCount       Int?     @default(0)
  publishedAt     DateTime
  isFeatured      Boolean  @default(false)
  isVisible       Boolean  @default(true)
  orderIndex      Int      @default(0)
  tags            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Motorcycle {
  id               String   @id @default(uuid())
  instagramMediaId String?  @unique
  permalink        String
  mediaType        String   @default("IMAGE")
  mediaUrl         String?
  thumbnailUrl     String
  caption          String
  brand            String?
  model            String?
  year             Int?
  price            Float?
  currency         String   @default("EUR")
  engine           String?
  status           String   @default("FOR_SALE")
  isFeatured       Boolean  @default(false)
  isVisible        Boolean  @default(true)
  orderIndex       Int      @default(0)
  publishedAt      DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model TaxiPost {
  id               String   @id @default(uuid())
  instagramMediaId String?  @unique
  permalink        String
  mediaType        String   @default("IMAGE")
  mediaUrl         String?
  thumbnailUrl     String
  caption          String
  isFeatured       Boolean  @default(false)
  isVisible        Boolean  @default(true)
  orderIndex       Int      @default(0)
  publishedAt      DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model TaxiReview {
  id                      String   @id @default(uuid())
  googleReviewId          String?  @unique
  authorName              String
  authorPhotoUrl          String?
  rating                  Int      @default(5)
  text                    String
  relativeTimeDescription String?
  publishedAt             DateTime @default(now())
  source                  String   @default("GOOGLE")
  isVisible               Boolean  @default(true)
  isFeatured              Boolean  @default(false)
  orderIndex              Int      @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model LuxuryVehicle {
  id                String   @id @default(uuid())
  name              String
  category          String   @default("LUXURY_CAR")
  title             String
  description       String
  imageUrl          String
  pricePerDay       Float?
  priceText         String?
  features          String?
  isFeatured        Boolean  @default(false)
  isVisible         Boolean  @default(true)
  orderIndex        Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Advertisement {
  id               String         @id @default(uuid())
  businessName     String
  title            String
  description      String?
  mediaUrl         String
  mediaType        String         @default("VIDEO")
  destinationUrl   String
  position         String         @default("HOMEPAGE_MIDDLE")
  ctaText          String         @default("Shiko Ofertën")
  startDate        DateTime?
  endDate          DateTime?
  status           String         @default("ACTIVE")
  priority         Int            @default(1)
  totalImpressions Int            @default(0)
  totalClicks      Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  impressions      AdImpression[]
  clicks           AdClick[]
}

model AdImpression {
  id              String        @id @default(uuid())
  advertisementId String
  advertisement   Advertisement @relation(fields: [advertisementId], references: [id], onDelete: Cascade)
  timestamp       DateTime      @default(now())
  userAgent       String?
  referrer        String?
}

model AdClick {
  id              String        @id @default(uuid())
  advertisementId String
  advertisement   Advertisement @relation(fields: [advertisementId], references: [id], onDelete: Cascade)
  timestamp       DateTime      @default(now())
  userAgent       String?
}

model SiteSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  group     String   @default("general")
  updatedAt DateTime @updatedAt
}

model CustomSection {
  id             String   @id @default(uuid())
  slug           String   @unique
  name           String
  title          String
  description    String?
  icon           String?
  isVisible      Boolean  @default(true)
  showOnHomepage Boolean  @default(true)
  orderIndex     Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SocialLink {
  id         String  @id @default(uuid())
  platform   String
  label      String
  url        String
  icon       String
  isVisible  Boolean @default(true)
  orderIndex Int     @default(0)
}

model SyncLog {
  id          String    @id @default(uuid())
  platform    String
  status      String
  itemsSynced Int       @default(0)
  message     String?
  errorDetail String?
  startedAt   DateTime  @default(now())
  completedAt DateTime?
}

model InstagramPost {
  id           String   @id @default(uuid())
  instagramId  String   @unique
  mediaUrl     String?
  thumbnailUrl String?
  caption      String
  permalink    String
  mediaType    String   @default("IMAGE")
  category     String   @default("SHITET")
  status       String   @default("FOR_SALE")
  isVisible    Boolean  @default(true)
  postedAt     DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
